# LiteLLM environment — installed to ~/.config/cc-hybrid/litellm.env  (chmod 600)
#
# CHANGE THE MASTER KEY. It is the only thing standing between anything on your
# laptop and your proxy (and, if you enable the cloud fallback, your API credits).
# Generate one with:  echo "sk-local-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-local-CHANGE-ME-0000000000000000000000000000

# Optional: only needed if you uncomment the cloud-sonnet fallback in
# litellm-config.yaml. This is a pay-as-you-go API key from the Anthropic
# Console — NOT your Claude Pro/Max subscription.
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Quieter startup.
LITELLM_LOG=ERROR
