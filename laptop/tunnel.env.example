# SSH tunnel settings — installed to ~/.config/cc-hybrid/tunnel.env
#
# SSH_TARGET must be a host you can reach with KEY-BASED auth and no passphrase
# prompt (use ssh-agent, or an unencrypted key dedicated to this). Define it in
# ~/.ssh/config so options live there rather than here. Example ~/.ssh/config:
#
#   Host quadro
#       HostName        quadro.example.internal
#       User            yourname
#       IdentityFile    ~/.ssh/id_ed25519
#       ControlMaster   no
#
SSH_TARGET=quadro

# Port on the LAPTOP that will forward to the node.
LOCAL_PORT=8080

# Port llama-server listens on, ON THE NODE.
REMOTE_PORT=8080
