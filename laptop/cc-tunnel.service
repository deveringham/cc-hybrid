[Unit]
Description=SSH tunnel to the Quadro node's llama-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/cc-hybrid/tunnel.env

# -N : no remote command, just forward
# -T : no pty
# ExitOnForwardFailure makes the unit fail loudly instead of sitting there
#      with a dead tunnel that LiteLLM then times out against.
ExecStart=/usr/bin/autossh -M 0 -N -T \
  -o "ServerAliveInterval 30" \
  -o "ServerAliveCountMax 3" \
  -o "ExitOnForwardFailure yes" \
  -o "StrictHostKeyChecking accept-new" \
  -L ${LOCAL_PORT}:127.0.0.1:${REMOTE_PORT} \
  ${SSH_TARGET}

Environment=AUTOSSH_GATETIME=0
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
