#!/usr/bin/env bash
# cc-status — one-glance view of whether the local path is usable.
set -uo pipefail

green() { printf '  \033[1;32m%-6s\033[0m %s\n' "UP" "$*"; }
red()   { printf '  \033[1;31m%-6s\033[0m %s\n' "DOWN" "$*"; }
grey()  { printf '         %s\n' "$*"; }

ENV_FILE="$HOME/.config/cc-hybrid/litellm.env"
TUN_FILE="$HOME/.config/cc-hybrid/tunnel.env"
[ -f "$ENV_FILE" ] && { set -a; . "$ENV_FILE"; set +a; }
[ -f "$TUN_FILE" ] && { set -a; . "$TUN_FILE"; set +a; }

echo
echo "cc-hybrid status"
echo "----------------"

# tunnel
if systemctl --user is-active --quiet cc-tunnel; then
  green "ssh tunnel (cc-tunnel) -> ${SSH_TARGET:-?}"
else
  red "ssh tunnel (cc-tunnel)"
  grey "start: systemctl --user start cc-tunnel"
fi

# llama-server through the tunnel
if curl -sf --max-time 5 http://127.0.0.1:8080/health >/dev/null 2>&1; then
  model=$(curl -sf --max-time 5 http://127.0.0.1:8080/v1/models 2>/dev/null \
          | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)
  nctx=$(curl -sf --max-time 5 http://127.0.0.1:8080/props 2>/dev/null \
          | grep -o '"n_ctx":[0-9]*' | head -1 | cut -d: -f2)
  green "llama-server  model=${model:-?}  ctx=${nctx:-?}"
else
  red "llama-server (via :8080)"
  grey "check on node: systemctl --user status llama-server"
fi

# litellm
if curl -sf --max-time 5 http://127.0.0.1:4000/health/liveliness >/dev/null 2>&1; then
  green "litellm proxy (:4000)"
else
  red "litellm proxy (:4000)"
  grey "start: systemctl --user start cc-litellm"
fi

# end-to-end: does the Anthropic-format endpoint actually answer?
if [ -n "${LITELLM_MASTER_KEY:-}" ]; then
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 90 \
    -X POST http://127.0.0.1:4000/v1/messages \
    -H "x-api-key: $LITELLM_MASTER_KEY" \
    -H "anthropic-version: 2023-06-01" \
    -H "content-type: application/json" \
    -d '{"model":"local-coder","max_tokens":8,"messages":[{"role":"user","content":"hi"}]}' 2>/dev/null)
  if [ "$code" = "200" ]; then
    green "end-to-end /v1/messages"
  else
    red "end-to-end /v1/messages (HTTP $code)"
    grey "logs: journalctl --user -u cc-litellm -n 40"
  fi
fi

echo
