[Unit]
Description=llama.cpp server (local coding model for Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/llama-server/llama-server.env

# --jinja is REQUIRED for tool calling. Without it Claude Code's tools
# silently never fire and the model just narrates what it would do.
ExecStart=/bin/sh -c '\
  exec "$LLAMA_BIN" \
    --model "$MODEL" \
    --alias "$ALIAS" \
    --host "$HOST" \
    --port "$PORT" \
    --ctx-size "$CTX_SIZE" \
    --n-gpu-layers "$NGL" \
    --tensor-split "$TENSOR_SPLIT" \
    --cache-type-k "$CACHE_TYPE_K" \
    --cache-type-v "$CACHE_TYPE_V" \
    --flash-attn "$FLASH_ATTN" \
    --parallel "$PARALLEL" \
    --batch-size "$BATCH_SIZE" \
    --ubatch-size "$UBATCH_SIZE" \
    --jinja \
    $EXTRA_ARGS'

Restart=on-failure
RestartSec=10

# Model load takes a few minutes from cold page cache.
TimeoutStartSec=900

# Keep the box usable while the server is running.
Nice=5

[Install]
WantedBy=default.target
