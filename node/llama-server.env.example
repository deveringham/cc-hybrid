# llama-server configuration for the Quadro node (2 x Quadro RTX 5000, 16 GB each)
#
# Installed to ~/.config/llama-server/llama-server.env
# Edit MODEL to the actual .gguf path printed by setup-node.sh, then:
#   systemctl --user restart llama-server

# --- paths -------------------------------------------------------------------
# IMPORTANT: these must be ABSOLUTE paths. systemd does not expand %h, $HOME or
# ~ inside an EnvironmentFile — values are taken literally. install-service.sh
# substitutes __HOME__ with your real home directory at install time.
LLAMA_BIN=__HOME__/llm/llama.cpp/build/bin/llama-server
MODEL=__HOME__/llm/models/Qwen3-Coder-30B-A3B-Instruct-GGUF/Qwen3-Coder-30B-A3B-Instruct-UD-Q4_K_XL.gguf

# --- network -----------------------------------------------------------------
# Bind to loopback ONLY. Access from the laptop goes through an SSH tunnel.
# Never set this to 0.0.0.0 — llama-server has no authentication.
HOST=127.0.0.1
PORT=8080

# --- model / context ---------------------------------------------------------
# Claude Code sends a large system prompt plus tool schemas on every request.
# 65536 is a reasonable floor; drop to 32768 if you hit OOM at startup.
CTX_SIZE=65536

# Name Claude Code / LiteLLM will refer to this model by.
ALIAS=local-coder

# Offload everything to GPU. 99 just means "all layers".
NGL=99

# Split evenly across both cards. Adjust if the GPUs are not identical.
TENSOR_SPLIT=0.5,0.5

# Quantize the KV cache. This is what makes 64k context fit in 32 GB alongside
# an 18 GB model. q8_0 costs very little quality.
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# Flash attention works on Turing (cc 7.5) in llama.cpp and cuts KV cache cost.
FLASH_ATTN=on

# Single agent session at a time. Raise only if you run concurrent clients;
# parallel slots divide CTX_SIZE between them.
PARALLEL=1

# Batch sizes. Larger -b helps prompt processing throughput, which dominates
# latency for Claude Code's long prompts. Lower if you see OOM.
BATCH_SIZE=2048
UBATCH_SIZE=512

# Reuse cached prefixes across turns. Big win for agent loops that resend
# a near-identical prompt each step.
# NOTE: values containing spaces must be quoted. systemd strips the quotes,
# and it keeps the file safe to `source` from a shell.
EXTRA_ARGS="--cache-reuse 256 --no-warmup"
